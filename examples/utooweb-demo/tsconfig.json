{
  "compilerOptions": {
    "target": "ES2018",
    "jsx": "react",
    "allowJs": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "module": "esnext",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true
  },
  "exclude": [
    "dist",
    "webpack.config.js",
    "genHtml.js"
  ]
}
