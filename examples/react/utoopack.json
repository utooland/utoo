{
  "$schema": "../../packages/pack/config_schema.json",
  "entry": [
    {
      "import": "./src/index.tsx",
      "html": {
        "template": "./index.html"
      },
      "name": "index"
    }
  ],
  "output": {
    "path": "./dist",
    "clean": true,
    "copy": [
      {
        "from": "./static/index.css",
        "to": "./index.css"
      }
    ]
  },
  "optimization": {
    "minify": false
  },
  "module": {
    "rules": {
      "*.svg": {
        "loaders": [
          {
            "loader": "@svgr/webpack"
          }
        ],
        "as": "*.js"
      }
    }
  },
  "react": {
    "runtime": "classic"
  }
}
