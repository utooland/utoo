{
    "$schema": "../../packages/pack/config_schema.json",
    "rootPath": "../../",
    "projectPath": "./",
    "config": {
        "entry": [
            {
                "import": "./src/index.tsx",
                "name": "index"
            }
        ],
        "output": {
            "path": "./dist",
            "clean": true,
            "copy": [
                {
                    "from": "./static/index.css",
                    "to": "./index.css"
                }
            ]
        },
        "optimization": {
            "minify": false
        },
        "module": {
            "rules": {
                "*.txt": {
                    "loaders": [
                        "./test-file-loader.js"
                    ],
                    "as": "*.js"
                }
            }
        }
    }
}