{
  "$schema": "../../packages/pack/config_schema.json",
  "rootPath": "../../",
  "projectPath": "./",
  "config": {
    "entry": [
      {
        "import": "./src/index.js"
      }
    ],
    "output": {
      "path": "./dist",
      "filename": "[name].[contenthash:6].js",
      "chunkFilename": "[name].[contenthash:8].js",
      "clean": true
    },
    "sourceMaps": false,
    "optimization": {
      "minify": {
        "extract_comments": true
      }
    }
  }
} 