{
  "$schema": "../../packages/pack/config_schema.json",
  "define": {
    "AAA": "\"aaa\"",
    "BBB": "\"bbb\"",
    "CCC": "1"
  },
  "entry": [
    {
      "import": "./src/index.ts",
      "html": {
        "template": "./index.html"
      }
    }
  ],
  "output": {
    "path": "./dist",
    "filename": "[name].[contenthash:6].js",
    "chunkFilename": "[name].[contenthash:8].js",
    "clean": true
  },
  "sourceMaps": false,
  "optimization": {
    "minify": false
  }
}
