{
  "$schema": "../../packages/pack/config_schema.json",
  "entry": [
    {
      "import": "./src/index.tsx",
      "html": {
        "template": "./index.html"
      },
      "name": "index"
    }
  ],
  "output": {
    "path": "./dist",
    "filename": "[name].[contenthash:8].js",
    "chunkFilename": "[name].[contenthash:8].js",
    "cssFilename": "[name].[contenthash:8].css",
    "clean": true
  },
  "optimization": {
    "minify": false
  },
  "server": {
    "functions": {
      "callServerModule": "./src/transport"
    }
  }
}
