{
  "entry": [
    {
      "import": "./index.js",
      "html": {
        "template": "./index.html"
      }
    }
  ],
  "output": {
    "path": "./dist",
    "clean": true
  },
  "optimization": {
    "splitChunks": {
      "js": {
        "minChunkSize": 2000,
        "maxChunkCountPerGroup": 1,
        "maxMergeChunkSize": 20000
      }
    }
  }
}
