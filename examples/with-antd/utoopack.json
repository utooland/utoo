{
  "entry": [
    {
      "import": "./src/index.tsx",
      "html": {
        "template": "./index.html"
      }
    }
  ],
  "styles": {
    "less": {
      "javascriptEnabled": true
    }
  },
  "output": {
    "path": "./dist",
    "filename": "[name].[contenthash:8].js",
    "chunkFilename": "[name].[contenthash:8].js",
    "clean": true
  },
  "optimization": {
    "minify": false,
    "moduleIds": "named",
    "splitChunks": {
      "js": {
        "minChunkSize": 50000,
        "maxChunkCountPerGroup": 40,
        "maxMergeChunkSize": 200000
      }
    }
  }
}
