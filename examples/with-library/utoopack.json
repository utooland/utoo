{
  "$schema": "../../packages/pack/config_schema.json",
  "entry": [
    {
      "name": "library",
      "import": "./src/index.ts",
      "library": {
        "name": "MyLibrary",
        "export": [
          "default",
          "value"
        ]
      }
    }
  ],
  "output": {
    "path": "./dist",
    "filename": "[name].[contenthash:8].js",
    "clean": true
  },
  "html": {
    "title": "with-library"
  },
  "optimization": {
    "moduleIds": "named",
    "minify": false
  },
  "externals": {
    "react": {
      "root": "React",
      "commonjs": "react"
    },
    "react-dom": {
      "root": "ReactDOM",
      "commonjs": "react-dom"
    }
  }
}
