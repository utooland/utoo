{
  "compilerOptions": {
    "rootDir": "./",
    "target": "ES2018",
    "module": "ESNext",
    "jsx": "react",
    "allowJs": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "pack.ts"
  ],
  "exclude": [
    "dist"
  ]
}
