{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./esm",
    "target": "ES2018",
    "lib": [
      "DOM",
      "WebWorker",
      "ESNext",
    ],
    "allowJs": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist"
  ]
}