{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./esm",
    "target": "ES2018",
    "lib": [
      "DOM",
      "WebWorker",
      "ESNext",
    ],
    "allowJs": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "@utoo/pack-shared": ["../pack-shared/src/index.ts"]
    }
  },
  "exclude": ["./esm", "./dist", "./cli", "./tmp", "./tests"]
}
