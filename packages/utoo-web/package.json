{
  "name": "@utoo/web",
  "version": "0.0.1",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "files": [
    "dist",
    "esm"
  ],
  "scripts": {
    "install-toolchain": "cargo install wasm-bindgen-cli@0.2.108 && brew install binaryen llvm",
    "build-wasm": "cargo build -p utoo-wasm --target wasm32-unknown-unknown -Z build-std=panic_abort,std",
    "build-wasm:pm": "cargo build -p utoo-wasm --target wasm32-unknown-unknown --no-default-features -Z build-std=panic_abort,std",
    "bindgen-dev": "wasm-bindgen ../../target/wasm32-unknown-unknown/wasm-dev/utoo_wasm.wasm --out-dir src/utoo --out-name index --target web --debug --keep-debug --no-demangle",
    "bindgen-build": "wasm-bindgen ../../target/wasm32-unknown-unknown/release/utoo_wasm.wasm --out-dir src/utoo --out-name index --target web",
    "bindgen-build:local": "wasm-bindgen ../../target/wasm32-unknown-unknown/release-local/utoo_wasm.wasm --out-dir src/utoo --out-name index --target web",
    "tsc": "rm -rf esm && tsc -p ./tsconfig.build.json",
    "copy-wasm": "cp src/utoo/index_bg.wasm esm/utoo",
    "build:shared": "npx turbo run build --filter=@utoo/pack-shared",
    "dev": "npm run build-wasm -- --profile wasm-dev && npm run bindgen-dev && npx turbo run tsc --filter=@utoo/web  && npm run build-workers && npm run copy-wasm",
    "dev:pm": "npm run build-wasm:pm -- --profile wasm-dev && npm run bindgen-dev && npm run tsc && npm run copy-wasm",
    "wasm-opt": "wasm-opt src/utoo/index_bg.wasm -o esm/utoo/index_bg.wasm --enable-threads --enable-bulk-memory --enable-reference-types --enable-simd --enable-exception-handling --enable-tail-call --enable-nontrapping-float-to-int -Oz",
    "build": "npm run build-wasm -- --release && npm run bindgen-build && npm run tsc && npm run build-workers && npm run wasm-opt",
    "build:local": "CC=$(brew --prefix llvm)/bin/clang CXX=$(brew --prefix llvm)/bin/clang++ npm run build-wasm -- --profile release-local && npm run bindgen-build:local && npm run build:shared && npm run tsc && npm run build-workers && npm run copy-wasm",
    "build-workers": "npm run build-worker && npm run build-threadWorker && npm run build-loaderWorker && npm run build-serviceWorker",
    "build-worker": "node cli/umd.js -e ./src/workers/worker.ts -o ./esm/workerInline.js -t webworker -np --base64-url",
    "build-threadWorker": "node cli/umd.js -e ./src/workers/threadWorker.ts -o ./esm/threadWorkerInline.js -t webworker -np --base64-url",
    "build-loaderWorker": "node cli/umd.js -e ./src/webpackLoaders/worker.ts -o ./esm/loaderWorkerInline.js -t webworker --base64-url",
    "build-serviceWorker": "node cli/umd.js -e ./src/serviceWorker/index.ts -o ./esm/serviceWorkerBundle.js -t webworker -np",
    "clean": "rm -rf esm src/utoo"
  },
  "dependencies": {
    "@utoo/pack-shared": "1.3.1",
    "comlink": "^4.4.2",
    "systemjs": "^6.15.1"
  },
  "devDependencies": {
    "@types/systemjs": "^6.15.1",
    "binaryen": "^125.0.0",
    "node-stdlib-browser": "^1.3.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.0.0",
    "webpack-merge": "^6.0.1",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "author": "xusd320",
  "license": "MIT",
  "repository": "git@github.com:utooland/utoo.git"
}
