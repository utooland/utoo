{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "ES2018",
    "allowJs": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "paths": {
      "@utoo/pack-shared": ["../pack-shared/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["es", "cjs"]
}
