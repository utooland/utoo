{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./cjs",
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "module": "esnext",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true
  },
  "include": ["src"],
  "exclude": ["src/__test__"]
}
