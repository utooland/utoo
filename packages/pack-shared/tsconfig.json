{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./esm",
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true
  }
}
