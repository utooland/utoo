{
    "compilerOptions": {
        "declaration": true,
        "esModuleInterop": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "strict": true,
        "skipLibCheck": true,
        "target": "es2019",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "outDir": "./dist",
        "rootDir": "./src"
    },
    "include": [
        "src"
    ]
}