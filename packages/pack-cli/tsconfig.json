{
  "compilerOptions": {
    "declaration": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": ["./src/**/*"],
  "ts-node": {
    "esm": true
  }
}
