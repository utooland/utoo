{
  "config": {
    "entry": [
      {
        "import": "./input/index.tsx",
        "name": "index"
      }
    ],
    "module": {
      "rules": {
        "*.txt": {
          "loaders": [
            "test-file-loader"
          ],
          "as": "*.js"
        },
        "*.mdx": [
          {
            "condition": {
              "query": {
                "type": "constant",
                "value": "?reverse"
              }
            },
            "loaders": [
              "reverse-loader"
            ],
            "as": "*.js"
          }
        ]
      }
    }
  }
}