#!/bin/sh
# utoo postinstall — fast path of the bootstrap flow.
#
#   npm i utoo (+ optional @utoo/utoo-${OS}-${ARCH} sibling)
#           │
#           ▼
#   detect OS / ARCH
#   find_node_modules @utoo/utoo-${OS}-${ARCH}
#           │
#           ├── present:  cp <opt>/bin/utoo → bin/utoo  (Win: utoo.exe in prefix)
#           │             real binary in place; user runs `utoo` directly.
#           │
#           └── absent:   return 0 with a "self-heal on first run" log.
#                         placeholder bin/utoo stays; bin/utoo will download
#                         the platform tarball itself on first invocation.
#
# Why no `npm i -g --force` fallback here: it recurses into another install,
# can deadlock the parent (Windows lock contention, EACCES on global prefix),
# and on failure leaves the bin permanently broken with no recovery path.
# The placeholder self-heal is bounded, idempotent, and doesn't touch global
# npm state. See vendor/templates/placeholder.utoo.sh.template.

# Get CPU & OS info - POSIX compatible (works with sh on Windows Git)
# Detect Windows via uname output (MINGW*/MSYS*/CYGWIN*) so kernel-version
# bumps on the host (e.g. Server 2022 -> 2025) don't change the package name.
UNAME_S=$(uname -s 2>/dev/null || echo "")
case "$UNAME_S" in
    MINGW*|MSYS*|CYGWIN*)
        IS_WIN=1
        ;;
    *)
        if [ "$OSTYPE" = "msys" ] || [ "$OSTYPE" = "win32" ]; then
            IS_WIN=1
        else
            IS_WIN=0
        fi
        ;;
esac

if [ "$IS_WIN" = "1" ]; then
    OS="win32"
    # On Windows, use PROCESSOR_ARCHITECTURE
    if [ "$PROCESSOR_ARCHITECTURE" = "AMD64" ] || [ "$PROCESSOR_ARCHITECTURE" = "x86_64" ]; then
        ARCH="x64"
    elif [ "$PROCESSOR_ARCHITECTURE" = "ARM64" ]; then
        ARCH="arm64"
    else
        ARCH="x64"  # default
    fi
else
    OS=$(echo "${UNAME_S:-unknown}" | tr '[:upper:]' '[:lower:]')
    ARCH=$(uname -m)
    if [ "$ARCH" = "x86_64" ]; then
        ARCH="x64"
    elif [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
        ARCH="arm64"
    fi
fi

# Function to find node_modules directory recursively
find_node_modules() {
    local current_dir="$1"
    local target_package="$2"

    # Check if we've reached the root directory
    if [ "$current_dir" = "/" ]; then
        return 1
    fi

    # Check if node_modules exists in current directory
    if [ -d "$current_dir/node_modules" ]; then
        if [ -d "$current_dir/node_modules/$target_package" ]; then
            echo "$current_dir/node_modules"
            return 0
        fi
    fi

    # Recursively check parent directory
    find_node_modules "$(dirname "$current_dir")" "$target_package"
}

# Function to install binary
install_binary() {
    local name=$1
    local package_name="@utoo/${name}-${OS}-${ARCH}"

    # Find the node_modules directory containing our package
    NODE_MODULES_DIR=$(find_node_modules "$(pwd)" "$package_name")

    if [ -z "$NODE_MODULES_DIR" ]; then
        # The optional platform dep is not present (e.g. installed with
        # --no-optional, --ignore-scripts skipped a sibling, or registry blip
        # on the optional fetch). Do not retry via `npm i -g --force` here:
        # that recurses into another install, can deadlock the parent install
        # (Windows lock contention, EACCES on global prefix), and on failure
        # leaves the bin permanently broken. Exit 0 so the placeholder bin
        # stays in place; it will self-heal on first invocation by downloading
        # the tarball directly from the registry.
        echo "utoo: optional ${package_name} not present; placeholder will self-heal on first run" >&2
        return 0
    fi

    # Create binary config
    mkdir -p bin

    # Copy file
    cp -f "${NODE_MODULES_DIR}/${package_name}/bin/${name}" "bin/${name}"
    chmod +x "bin/${name}"

    # Windows: copy as .exe to npm prefix and remove shims
    # npm generates .ps1/.cmd shims that call /bin/sh which doesn't exist on Windows.
    # Placing the PE binary as .exe makes it directly executable by pwsh/cmd/bash.
    if [ "$OS" = "win32" ]; then
        PREFIX_DIR=$(cd "../.." 2>/dev/null && pwd)
        if [ -n "$PREFIX_DIR" ]; then
            cp -f "bin/${name}" "${PREFIX_DIR}/${name}.exe"
            rm -f "${PREFIX_DIR}/${name}.ps1" "${PREFIX_DIR}/${name}.cmd" "${PREFIX_DIR}/${name}"
        fi
    fi
}

# Install binary
install_binary "utoo"

# Windows: create ut.exe alias and utx.cmd wrapper
if [ "$OS" = "win32" ]; then
    PREFIX_DIR=$(cd "../.." 2>/dev/null && pwd)
    if [ -n "$PREFIX_DIR" ] && [ -f "${PREFIX_DIR}/utoo.exe" ]; then
        # ut is a direct alias for utoo
        cp -f "${PREFIX_DIR}/utoo.exe" "${PREFIX_DIR}/ut.exe"
        rm -f "${PREFIX_DIR}/ut.ps1" "${PREFIX_DIR}/ut.cmd" "${PREFIX_DIR}/ut"

        # utx delegates to "utoo x" (execute subcommand)
        printf '@utoo.exe x %%*\r\n' > "${PREFIX_DIR}/utx.cmd"
        rm -f "${PREFIX_DIR}/utx.ps1" "${PREFIX_DIR}/utx"
    fi
fi
