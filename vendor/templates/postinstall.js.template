#!/usr/bin/env node

const { execSync } = require("child_process");
const { cpSync, writeFileSync, mkdirSync, existsSync, chmodSync, unlinkSync } = require("fs");
const { join, dirname } = require("path");

// Detect OS and arch
const IS_WINDOWS = process.platform === "win32";
let OS, ARCH;
if (IS_WINDOWS) {
  OS = "win32";
  ARCH = process.arch === "arm64" ? "arm64" : "x64";
} else {
  OS = process.platform === "darwin" ? "darwin" : "linux";
  ARCH = process.arch === "arm64" ? "arm64" : "x64";
}

function findNodeModules(dir, pkg) {
  const root = IS_WINDOWS ? dir.split("\\")[0] + "\\" : "/";
  while (dir !== root && dir !== dirname(dir)) {
    const candidate = join(dir, "node_modules", pkg);
    if (existsSync(candidate)) {
      return join(dir, "node_modules");
    }
    dir = dirname(dir);
  }
  return null;
}

function installBinary(name) {
  const packageName = `@utoo/${name}-${OS}-${ARCH}`;
  const nodeModulesDir = findNodeModules(process.cwd(), packageName);

  if (!nodeModulesDir) {
    console.log(`Binary package ${packageName} not found, installing globally...`);
    try {
      execSync(`npm i -g ${packageName} --force`, { stdio: "inherit" });
    } catch {
      console.error(`Failed to install ${packageName}`);
      process.exit(1);
    }
    return;
  }

  mkdirSync("bin", { recursive: true });

  const src = join(nodeModulesDir, packageName, "bin", name);
  const dest = join("bin", name);
  cpSync(src, dest);
  try { chmodSync(dest, 0o755); } catch { /* Windows may not support chmod */ }

  if (IS_WINDOWS) {
    // Create .exe copy — Windows requires .exe extension for native binaries
    const exeDest = dest + ".exe";
    cpSync(src, exeDest);

    // Fix npm-generated shims that use /bin/bash (doesn't exist on Windows).
    // npm creates shims in the parent bin directory (e.g. <prefix>/ or <prefix>/bin/).
    fixWindowsShims(name, exeDest);
  }

  console.log(`Installed ${name} binary from ${packageName}`);
}

/**
 * Fix npm-generated .cmd and .ps1 shims on Windows.
 *
 * npm generates shims based on the placeholder's #!/bin/bash shebang,
 * which produces .ps1 files that call /bin/bash.exe (doesn't exist)
 * and .cmd files that try to use bash. Replace them with shims that
 * invoke the native .exe binary directly.
 */
function fixWindowsShims(name, exePath) {
  // npm global install: shims are in <prefix>/ (parent of node_modules)
  // npm local install: shims are in node_modules/.bin/
  const shimDirs = [
    join(process.cwd(), "..", ".."),          // <prefix>/ for global
    join(process.cwd(), "..", ".bin"),         // node_modules/.bin/ for local
  ];

  for (const shimDir of shimDirs) {
    if (!existsSync(shimDir)) continue;

    // Remove broken .ps1 (PowerShell prioritizes .ps1 over .cmd)
    const ps1 = join(shimDir, `${name}.ps1`);
    try { if (existsSync(ps1)) unlinkSync(ps1); } catch { /* ignore */ }

    // Overwrite .cmd to invoke native binary directly
    const cmd = join(shimDir, `${name}.cmd`);
    try {
      writeFileSync(cmd, `@"${exePath}" %*\r\n`);
    } catch { /* ignore */ }

    // Create/overwrite bash shim (no extension) for Git Bash / npm scripts
    const bashShim = join(shimDir, name);
    try {
      writeFileSync(bashShim, `#!/bin/sh\nexec "${exePath}" "$@"\n`);
    } catch { /* ignore */ }
  }
}

// Install the main binary
installBinary("utoo");

// Also fix shims for "ut" alias (points to same binary)
if (IS_WINDOWS) {
  const utooExe = join("bin", "utoo.exe");
  if (existsSync(utooExe)) {
    fixWindowsShims("ut", utooExe);
  }
}
