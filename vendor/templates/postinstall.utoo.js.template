#!/usr/bin/env node
"use strict";
// utoo postinstall — fast path of the bootstrap flow (Node implementation).
//
//   npm i utoo (+ optional @utoo/utoo-${os}-${arch} sibling)
//           │
//           ▼
//   detect os / arch (process.platform / process.arch — drift-proof, no uname)
//   locate @utoo/utoo-${os}-${arch} in node_modules
//           │
//           ├── present:  copy <opt>/bin/utoo → bin/utoo
//           │             Windows: also drop utoo.exe/ut.exe into the npm
//           │             prefix and remove npm's shims so `utoo` runs the
//           │             native exe directly (no node/sh wrapper).
//           │
//           └── absent:   exit 0; the bin/utoo placeholder self-heals on first
//                         run by downloading the platform tarball itself.
//
// Why Node instead of `sh ./postinstall.sh`: npm runs lifecycle scripts through
// cmd.exe on Windows, where `sh` is not on PATH for a stock Node install (even a
// default Git for Windows setup does not add sh.exe to PATH). `node` is always
// present during `npm install`, so this runs on every platform.
//
// Why no `npm i -g --force` fallback when the optional dep is missing: it
// recurses into another install, can deadlock the parent (Windows lock
// contention, EACCES on the global prefix), and on failure leaves the bin
// permanently broken. The placeholder self-heal is bounded and idempotent.
// See vendor/templates/placeholder.utoo.js.template.

const fs = require("fs");
const path = require("path");

const BIN = "utoo";

// process.platform is already win32 | darwin | linux and process.arch is
// already x64 | arm64, matching the package os/cpu names exactly. The env
// overrides exist for emulated environments and for the e2e tests, which
// exercise the Windows code paths from a Linux/macOS host.
function detect() {
  let os = process.env.UTOO_TARGET_OS || process.platform;
  let arch = process.env.UTOO_TARGET_ARCH || process.arch;
  if (arch === "amd64") arch = "x64";
  if (arch === "aarch64") arch = "arm64";
  // No native Windows arm64 build yet; the x64 binary runs under Windows 11
  // arm64 emulation, so prefer it over a guaranteed 404 on a non-existent pkg.
  if (os === "win32" && arch === "arm64") arch = "x64";
  return { os, arch };
}

// Find <pkg>/bin/<binName> for the hoisted optional platform dependency.
function locatePlatformBin(pkgName, binName) {
  try {
    const pj = require.resolve(path.join(pkgName, "package.json"), {
      paths: [process.cwd(), __dirname],
    });
    const p = path.join(path.dirname(pj), "bin", binName);
    if (fs.existsSync(p)) return p;
  } catch {
    /* not resolvable — fall through to the manual walk */
  }
  let dir = process.cwd();
  for (;;) {
    const p = path.join(dir, "node_modules", pkgName, "bin", binName);
    if (fs.existsSync(p)) return p;
    const parent = path.dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}

function rmQuiet(p) {
  try {
    fs.rmSync(p, { force: true });
  } catch {
    /* best effort */
  }
}

// True when `dir` is an npm global prefix: npm links a package's bins into the
// prefix root before postinstall runs, so the launcher shims for `utoo` are
// already there. A local install puts bins under node_modules/.bin instead, so
// the project root (which is what prefixDir resolves to) has none of these.
function hasGlobalShims(dir) {
  return ["utoo", "utoo.cmd", "utoo.ps1"].some((s) =>
    fs.existsSync(path.join(dir, s)),
  );
}

// Windows: place the PE binary as `<name>.exe` in the npm prefix and drop the
// shims npm generated for the placeholder. PATHEXT resolves `<name>` to
// `<name>.exe` ahead of any leftover `<name>.cmd`, so this is robust even when
// a shim can't be removed because it is in use.
function winInstallExe(prefixDir, name, srcExe) {
  fs.copyFileSync(srcExe, path.join(prefixDir, name + ".exe"));
  for (const ext of ["", ".cmd", ".ps1"]) rmQuiet(path.join(prefixDir, name + ext));
}

function main() {
  const { os, arch } = detect();
  const pkgName = `@utoo/${BIN}-${os}-${arch}`;
  const srcBin = locatePlatformBin(pkgName, BIN);

  if (!srcBin) {
    console.error(
      `utoo: optional ${pkgName} not present; placeholder will self-heal on first run`,
    );
    return;
  }

  const binDir = path.join(__dirname, "bin");
  fs.mkdirSync(binDir, { recursive: true });
  const destBin = path.join(binDir, BIN);

  if (os !== "win32") {
    // POSIX: overwrite the placeholder with the native binary. npm's symlink
    // shim then resolves straight to it.
    fs.copyFileSync(srcBin, destBin);
    try {
      fs.chmodSync(destBin, 0o755);
    } catch {
      /* chmod is a no-op / may fail */
    }
    return;
  }

  // Windows: keep the JS placeholder at bin/utoo and drop the native binary
  // alongside it as bin/utoo.exe. The placeholder execs the sibling exe, so a
  // local install works too — overwriting bin/utoo with the PE would make npm's
  // `node bin/utoo` shim try to run a binary as JavaScript.
  const localExe = destBin + ".exe";
  fs.copyFileSync(srcBin, localExe);

  // Global install only: npm writes the launcher shims into the prefix root
  // before postinstall runs, so replace them with the native exe to drop the
  // node wrapper. For a local install prefixDir is the project root and no such
  // shims exist there — skip, so we never pollute it.
  const prefixDir = path.resolve(__dirname, "..", "..");
  if (!hasGlobalShims(prefixDir)) return;
  try {
    winInstallExe(prefixDir, "utoo", localExe);
    winInstallExe(prefixDir, "ut", localExe); // `ut` is an alias for `utoo`
    // utx → `utoo x ...`
    fs.writeFileSync(path.join(prefixDir, "utx.cmd"), "@utoo.exe x %*\r\n");
    rmQuiet(path.join(prefixDir, "utx"));
    rmQuiet(path.join(prefixDir, "utx.ps1"));
  } catch (err) {
    console.error(`utoo: could not finalize Windows prefix shims: ${err.message}`);
  }
}

main();
